{
  "name": "better-mayhem-tracker",
  "version": "1.3.1",
  "private": true,
  "description": "ARAM Mayhem match history tracker for Windows and macOS",
  "homepage": "https://github.com/rambo0247/better-mayhem-tracker",
  "license": "MIT",
  "author": "rambo0247",
  "repository": {
    "type": "git",
    "url": "https://github.com/rambo0247/better-mayhem-tracker.git"
  },
  "workspaces": [
    "tauri",
    "parity"
  ],
  "scripts": {
    "build": "bun run --filter ./tauri build",
    "tauri": "bun run --filter ./tauri tauri",
    "lint": "bun run --filter ./tauri --filter ./parity lint",
    "fmt": "bun run --filter ./tauri --filter ./parity fmt",
    "fmt:check": "bun run --filter ./tauri --filter ./parity fmt:check",
    "typecheck": "bun run --filter ./tauri typecheck",
    "test": "bun run --filter ./tauri --filter ./parity test",
    "gen:augments": "bun run --filter ./tauri gen:augments"
  },
  "overrides": {
    "vite": "8.4.0-beta.1"
  }
}
