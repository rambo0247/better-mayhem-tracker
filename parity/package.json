{
  "name": "bmt-parity",
  "version": "0.0.0",
  "private": true,
  "description": "Parity tooling for the Tauri port: baselines, diff gate, anonymized fixture",
  "type": "module",
  "scripts": {
    "test": "bash lib/capped.sh 200 bun test",
    "capture": "bash lib/capped.sh 200 bun capture.ts",
    "diff": "bun diff.ts",
    "lint": "bun lint --flavor eslint --max-warnings 0",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check"
  },
  "dependencies": {
    "pixelmatch": "8.0.0",
    "playwright": "1.66.0-alpha-2026-11-22",
    "pngjs": "7.0.0"
  }
}
